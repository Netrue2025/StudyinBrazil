generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model University {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  acronym     String
  region      String
  state       String
  city        String
  type        String
  description String
  website     String?
  campuses    String            @default("[]")
  programs    Program[]
  applications OpenApplication[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([region])
  @@index([state])
  @@index([type])
}

model Program {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  universityId      String            @db.ObjectId
  degreeLevel       String
  fieldOfStudy      String
  description       String
  officialLink      String?
  applicationStatus String            @default("Unknown")
  university        University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  applications      OpenApplication[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([degreeLevel])
  @@index([fieldOfStudy])
  @@index([applicationStatus])
}

model OpenApplication {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  universityId      String      @db.ObjectId
  programId         String?     @db.ObjectId
  summary           String
  fullDescription   String
  requirements      String      @default("[]")
  requiredDocuments String      @default("[]")
  howToApply        String
  openingDate       DateTime?
  deadline          DateTime?
  status            String      @default("Open")
  badge             String      @default("Open Now")
  bannerImage       String?
  officialLink      String?
  showInHero        Boolean     @default(false)
  university        University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program           Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([showInHero])
}

model ApplicationSubmission {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  fullName            String
  email               String
  phone               String
  countryOfResidence  String
  nationality         String
  dateOfBirth         DateTime?
  highestQualification String
  fieldOfStudy        String
  desiredDegreeLevel  String
  preferredUniversity String?
  preferredProgram    String?
  preferredStateCity  String?
  intendedIntakeYear  String?
  supportNeeded       String             @default("[]")
  notes               String?
  status              String             @default("New")
  internalNotes        String?
  documents           UploadedDocument[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([email])
}

model UploadedDocument {
  id                      String                @id @default(auto()) @map("_id") @db.ObjectId
  applicationSubmissionId String                @db.ObjectId
  documentType            String
  fileUrl                 String
  fileName                String
  applicationSubmission   ApplicationSubmission @relation(fields: [applicationSubmissionId], references: [id], onDelete: Cascade)
  createdAt               DateTime              @default(now())
}

model Service {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String         @unique
  description  String
  price        Int
  currency     String         @default("USD")
  deliveryTime String
  includes     String         @default("[]")
  isActive     Boolean        @default(true)
  orders       ServiceOrder[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ServiceOrder {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  serviceId     String    @db.ObjectId
  fullName      String
  email         String
  phone         String
  notes         String?
  status        String    @default("Pending")
  paymentStatus String    @default("Pending")
  adminNotes    String?
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([paymentStatus])
}

model Payment {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  serviceOrderId    String       @db.ObjectId
  amount            Int
  currency          String
  provider          String
  providerReference String?
  status            String       @default("Pending")
  serviceOrder      ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@index([status])
}

model SiteSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
